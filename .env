# Google OAuth Client ID (must match the OAuth Web Client ID in Google Cloud Console and Apps Script)
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID

# Google Apps Script Web App URL, must end with /exec and match the deployed Apps Script
VITE_ERP_WEB_APP_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Optional app metadata
VITE_APP_NAME=ERP
VITE_APP_ENV=development
