# Google Identity Services OAuth 2.0 Web Client ID; public, not a secret
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID.apps.googleusercontent.com

# Set in Cloudflare Pages project > Settings > Variables and Secrets:
# (not a VITE_ variable, never bundled into browser JS)
# GAS_WEB_APP_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Set these in Google Apps Script > Project Settings > Script Properties:
# SPREADSHEET_ID=your_google_sheet_id
# GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID.apps.googleusercontent.com
# INITIAL_ADMIN_EMAIL=your_admin_google_email
# DOCUMENTS_FOLDER_ID=your_shared_drive_folder_id
# GEMINI_API_KEY=your_gemini_api_key