# Public frontend configuration only.
# These VITE_* values are bundled into browser code; never put secrets here.
# Use the same OAuth Web Client ID as GOOGLE_CLIENT_ID in Apps Script.
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID

# Deployed Google Apps Script Web App URL, ending in /exec.
# Open the ERP through this URL; direct frontend access is not the supported login flow.
VITE_ERP_WEB_APP_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec
