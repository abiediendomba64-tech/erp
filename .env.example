# React front-end public settings only. These are not secret keys.
VITE_GAS_WEB_APP_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID.apps.googleusercontent.com

# Do not put Gemini API keys, Google refresh tokens, Telegram bot tokens, WhatsApp
# access tokens, or webhook secrets in any VITE_* variable.
# Store server credentials in Apps Script > Project Settings > Script Properties.
