# Firebase Web App config. API keys used by the browser are public identifiers, not admin secrets.
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
# Optional, only for Firebase email link/action URL configuration:
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
