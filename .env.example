# ERP local environment template
# Copy this file to .env and fill in your real values.
# IMPORTANT: .env is git-ignored and must not be committed.

# Google OAuth Client ID (must match the same value configured in Google Cloud Console and Apps Script script properties)
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID

# Google Apps Script Web App URL. Must end with /exec and match the deployed Apps Script URL.
VITE_ERP_WEB_APP_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Optional app metadata
VITE_APP_NAME=ERP
VITE_APP_ENV=development
